{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false
  },
  "tabs": {
    "mode": "auto",
    "layout": "vertical",
    "indicators": "status"
  },
  "diffs": {
    "single": false
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.6
  },
  "debug": {
    "devtools": false
  }
}
