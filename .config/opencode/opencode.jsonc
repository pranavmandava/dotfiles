{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "autoupdate": true,
  "mcp": {
    "servers": {
      "react-grab-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@react-grab/mcp",
          "--stdio"
        ]
      }
    }
  }
}